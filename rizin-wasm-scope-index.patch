+	mu_assert_notnull(op, "br_if");
+	mu_assert_eq(op->type, (ut64)(ut32)RZ_ANALYSIS_OP_TYPE_CJMP, "conditional jump");
+	mu_assert_eq(op->jump, 0x17, "br_if 0 targets the loop start");
