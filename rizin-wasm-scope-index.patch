+static size_t io_write_hooks(RzCore *core) {
+	RzEvent *ev = core->io ? core->io->event : NULL;
+	RzVector *cbs = ev ? ht_up_find(ev->callbacks, (ut64)RZ_EVENT_IO_WRITE, NULL) : NULL;
+	return cbs ? rz_vector_len(cbs) : 0;
+}
