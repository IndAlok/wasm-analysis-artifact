+	io = analysis->iob.io;
+	if (!io || !io->event) {
+		return;
+	}
+	rz_event_unhook_by_callback(io->event, RZ_EVENT_IO_WRITE, wasm_on_io_write, analysis);
+	rz_event_hook(io->event, RZ_EVENT_IO_WRITE, wasm_on_io_write, analysis);
